<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Publish"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Push an attendance.json summary to a GitHub repo. The Session 6 website will read this file to show your dashboard publicly — nothing here touches your Syncthing folder."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/patInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Fine-grained PAT (Contents: read and write)"
            android:inputType="textPassword"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/ownerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Repo owner (e.g. your GitHub username)"
            android:inputType="text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/repoInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Repo name (e.g. attendance-data)"
            android:inputType="text"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/pathInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="File path in repo"
            android:inputType="text"
            android:text="attendance.json"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/branchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Branch"
            android:inputType="text"
            android:text="main"
            android:textSize="14sp" />

        <Button
            android:id="@+id/saveSettingsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save settings" />

        <Button
            android:id="@+id/publishButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Publish now" />

        <TextView
            android:id="@+id/publishStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/publishedUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:autoLink="web"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
